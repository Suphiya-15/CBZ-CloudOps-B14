program 19: Devops example


def check_cpu(cpu):
    if cpu > 80:
        print("CPU usage is HIGH")
    else:
        print("CPU usage is NORMAL")

def check_disk(disk):
    if disk > 75:
        print("Disk usage is HIGH")
    else:
        print("Disk usage is NORMAL")

def check_memory(memory):
    if memory > 90:
        print("Memory usage is HIGH")
    else:
        print("Memory usage is NORMAL")

def monitoring(cpu,memory,disk):
    print("-----Server Monitoring-----")
    check_cpu(cpu)
    check_memory(memory)
    check_disk(disk)

monitoring(80,75,96)

