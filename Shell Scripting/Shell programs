script 27:

#!/bin/bash

check_service()
{
       systemctl is-active $1
       if [ $? -eq 0 ]
       then
                 echo "$1 is runnning"
              else
                 echo "$1 is not running"
       fi
}

check_service httpd
check_service nginx
check_service ssh
check_service docker

# #? means the exit status of the last executed command
# it tells us whether the pervious command was successful or failed

