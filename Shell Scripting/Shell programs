script 6 : argument passing

#argument passing means giving some values to a shell script when we run the script.
#Positional paramaters

variable            meaning
   $0             script name
   $1             First argument
   $2             Second argument
   $3             third argument
   $#             no of argument
   $@             All arguments

   #!/bin/bash

   echo "First argument is: $1"
   echo "Second argument is: $2"
   echo "Third argument is: $3"
   echo "All arguments are: $@"
   echo "No of arguments: $#"

